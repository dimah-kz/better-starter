# Copy to .env and fill in values.

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/better_starter

# Better Auth (required)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Public site URL for absolute links (optional in local dev)
NEXT_PUBLIC_URL=http://localhost:3000

# S3-compatible object storage (required for uploads)
S3_REGION=auto
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_DEFAULT_BUCKET=your-bucket-name
# Public base URL for object keys (CDN or public bucket; no trailing slash)
S3_PUBLIC_BASE_URL=https://your-cdn.example.com

