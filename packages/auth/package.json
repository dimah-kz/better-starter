{
  "name": "@repo/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/auth-api-error.ts",
    "./admin-access": "./src/admin-access.ts",
    "./organization-access": "./src/organization-access.ts"
  },
  "scripts": {
