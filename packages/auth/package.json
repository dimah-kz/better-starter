    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.0",
    "@better-auth/i18n": "1.7.0",
    "@repo/db": "workspace:*",
    "@repo/i18n": "workspace:*",
    "better-auth": "1.7.0",
    "drizzle-orm": "rc"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "auth": "1.7.0",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
